{
  "name": "vimma",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "npm run sync-core && tsc -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "gen-docs": "node tools/gen-docs.mjs && prettier --log-level warn --write docs/bindings.md",
    "sync-core": "node tools/sync-core.mjs",
    "version-files": "node tools/version-files/version-files.mjs",
    "import": "npm run sync-core && npm run version-files && surfer config brand vimma && surfer import && SURFER_MOZCONFIG_ONLY=1 surfer build",
    "mochitest": "node tools/mochitest.mjs",
    "lane:setup": "node tools/lanes/lane-setup.mjs",
    "lane:teardown": "node tools/lanes/lane-teardown.mjs",
    "test:py": "python3 -m unittest discover -s tools/upstream",
    "license-check": "node tools/license-check/license-check.mjs",
    "license-check:crates": "node tools/license-check/cargo-license-check.mjs",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@zen-browser/surfer": "^1.14.9",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
