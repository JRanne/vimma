ac_add_options --with-app-name=${binName}
export MOZ_USER_DIR="${name}"
export MOZ_APP_BASENAME=${name}
export MOZ_DISTRIBUTION_ID=${appId}

# Uncomment if builds are too resource hungry
# mk_add_options MOZ_MAKE_FLAGS="-j4"
# ac_add_options --enable-linker=gold

# Misc
export MOZ_STUB_INSTALLER=1
export MOZ_INCLUDE_SOURCE_INFO=1
# Change the below repository to your GitHub repository.
export MOZ_SOURCE_REPO=https://github.com/JRanne/vimma
export MOZ_SOURCE_CHANGESET=${changeset}

# Bootstrap
ac_add_options --enable-bootstrap

# Mozilla services (docs/specs/m0-mozilla-services.md). No crash reporter: its server is
# crash-reports.mozilla.com and no pref changes that; M6 brings opt-in reporting to our own.
ac_add_options --disable-crashreporter
# Telemetry does not upload because MOZILLA_OFFICIAL is unset (MOZ_TELEMETRY_REPORTING defaults
# to it). MOZ_DATA_REPORTING is computed by configure, so neither can be set with mk_add_options.

# App version (docs/specs/m0-app-version.md). Surfer writes displayVersion into both stock
# browser/config/version{,_display}.txt; configure reads these instead (npm run version-files):
# version.txt is the Firefox version (appinfo.version), version_display.txt is Vimma's.
ac_add_options --with-version-file-path=browser/config/vimma
# configure silently falls back to Surfer's 0.1.0 if these are missing, so fail loudly instead.
for _vimma_version_file in version.txt version_display.txt; do
  if [ ! -s "$topsrcdir/browser/config/vimma/$_vimma_version_file" ]; then
    echo "mozconfig: browser/config/vimma/$_vimma_version_file is missing; run 'npm run import'" >&2
    exit 1
  fi
done
unset _vimma_version_file
