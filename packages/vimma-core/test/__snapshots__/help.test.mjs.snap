// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`help table > help text for defaults matches the snapshot 1`] = `
"Help
  show_keybinds        prefix+?                                            Show all bindings (filter with /)
  help_close           <Esc> [help], q [help]                              Close the bindings overlay
  help_filter          / [help]                                            Filter the bindings overlay

Tabs
  new_tab              prefix+c, t                                         New tab
  next_tab             prefix+n, gt                                        Next tab (with a count: go to tab N)
  previous_tab         prefix+p, gT                                        Previous tab
  select_tab_1         prefix+1                                            Jump to tab 1 in this workspace
  select_tab_2         prefix+2                                            Jump to tab 2 in this workspace
  select_tab_3         prefix+3                                            Jump to tab 3 in this workspace
  select_tab_4         prefix+4                                            Jump to tab 4 in this workspace
  select_tab_5         prefix+5                                            Jump to tab 5 in this workspace
  select_tab_6         prefix+6                                            Jump to tab 6 in this workspace
  select_tab_7         prefix+7                                            Jump to tab 7 in this workspace
  select_tab_8         prefix+8                                            Jump to tab 8 in this workspace
  select_tab_9         prefix+9                                            Jump to tab 9 in this workspace
  rename_tab           prefix+shift+t                                      Rename tab
  close_tab            prefix+shift+x, x                                   Close tab

Panes
  split_vertical       prefix+v                                            Split right
  split_horizontal     prefix+minus                                        Split down
  focus_pane_left      prefix+h, <C-w>h                                    Focus pane to the left
  focus_pane_down      prefix+j, <C-w>j                                    Focus pane below
  focus_pane_up        prefix+k, <C-w>k                                    Focus pane above
  focus_pane_right     prefix+l, <C-w>l                                    Focus pane to the right
  swap_pane_left       prefix+shift+h, <C-w>H                              Swap with pane to the left
  swap_pane_down       prefix+shift+j, <C-w>J                              Swap with pane below
  swap_pane_up         prefix+shift+k, <C-w>K                              Swap with pane above
  swap_pane_right      prefix+shift+l, <C-w>L                              Swap with pane to the right
  zoom                 prefix+z, <C-w>o                                    Zoom pane
  close_pane           prefix+x                                            Close pane; the last pane closes the tab
  resize_mode          prefix+r                                            Resize mode
  resize_exit          <Esc> [resize], <CR> [resize], q [resize]           Leave resize mode
  resize_narrower      <C-w><, h [resize], <Left> [resize], <lt> [resize]  Make pane narrower
  resize_wider         <C-w>>, l [resize], <Right> [resize], > [resize]    Make pane wider
  resize_taller        <C-w>+, j [resize], <Down> [resize], + [resize]     Make pane taller
  resize_shorter       <C-w>-, k [resize], <Up> [resize], - [resize]       Make pane shorter

Workspaces
  next_workspace       ctrl+i                                              Next workspace
  previous_workspace   ctrl+u                                              Previous workspace
  switch_workspace     (unbound)                                           Switch to a workspace by name or number
  workspace_picker     prefix+w                                            Workspace picker
  new_workspace        prefix+shift+n                                      New workspace
  rename_workspace     prefix+shift+w                                      Rename workspace
  close_workspace      prefix+shift+d                                      Close workspace
  move_to_workspace    (unbound)                                           Move the tab to another workspace (reopens it there)
  route_rules          (unbound)                                           Routing rules: list them; :route add [workspace], :route move

Navigation
  goto_picker          prefix+g, b                                         Goto picker: every tab in every workspace
  toggle_sidebar       prefix+b, <leader>n                                 Open / close the side panel
  scroll_down          j                                                   Scroll down
  scroll_up            k                                                   Scroll up
  scroll_left          h                                                   Scroll left
  scroll_right         l                                                   Scroll right
  scroll_half_down     d                                                   Scroll half a page down
  scroll_half_up       u                                                   Scroll half a page up
  scroll_top           gg                                                  Scroll to top
  scroll_bottom        G                                                   Scroll to bottom
  history_back         H                                                   Go back
  history_forward      L                                                   Go forward
  reload               r                                                   Reload page
  open_url             (unbound)                                           Open a URL or search in this tab

Hints
  follow_link          f                                                   Follow link
  follow_link_new_tab  F                                                   Follow link in new tab
  hint_cancel          <Esc> [hint]                                        Leave hint mode

Find
  find_forward         /                                                   Search in page
  find_backward        ?                                                   Search backwards in page
  find_next            n                                                   Next match
  find_previous        N                                                   Previous match

Modes
  normal_mode          <Esc> [insert], <Esc> [visual]                      Back to normal mode
  insert_mode          i                                                   Insert mode: focus the first input
  copy_mode            prefix+[, v                                         Copy mode (caret browsing + selection)
  command_line         :                                                   Command line
  command_cancel       <Esc> [command]                                     Close the command line

Copy mode
  caret_left           h [visual]                                          Move caret left
  caret_down           j [visual]                                          Move caret down
  caret_up             k [visual]                                          Move caret up
  caret_right          l [visual]                                          Move caret right
  caret_word_forward   w [visual]                                          Move caret a word forward
  caret_word_backward  b [visual]                                          Move caret a word back
  caret_line_start     0 [visual]                                          Move caret to the start of the line
  caret_line_end       $ [visual]                                          Move caret to the end of the line
  caret_top            gg [visual]                                         Move caret to the top of the page
  caret_bottom         G [visual]                                          Move caret to the bottom of the page
  toggle_selection     v [visual]                                          Start or drop a selection at the caret
  yank_selection       y [visual]                                          Copy selection and leave copy mode

Side panel
  panel_select_1       1 [panel]                                           Select row 1
  panel_select_2       2 [panel]                                           Select row 2
  panel_select_3       3 [panel]                                           Select row 3
  panel_select_4       4 [panel]                                           Select row 4
  panel_select_5       5 [panel]                                           Select row 5
  panel_select_6       6 [panel]                                           Select row 6
  panel_select_7       7 [panel]                                           Select row 7
  panel_select_8       8 [panel]                                           Select row 8
  panel_select_9       9 [panel]                                           Select row 9
  panel_down           j [panel]                                           Next row
  panel_up             k [panel]                                           Previous row
  panel_open           <CR> [panel]                                        Open the selected row
  panel_close          <Esc> [panel]                                       Close the side panel

Config
  reload_config        (unbound)                                           Reload config
  edit_config          (unbound)                                           Open config.toml in a tab
"
`;
